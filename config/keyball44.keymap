#define DEFAULT 0
#define NUM     1
#define FUN     2
#define EDIT    3
#define SNIPE   4
#define VSCROLL 5
#define HSCROLL 6
#define SETTING 7
#define SWITCH  8
#define OPTIONS 9

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>
#include "behaviors.dtsi"
#include "combos.dtsi"

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
                &mo OPTIONS  &kp B     &kp L     &kp D              &kp W                 &kp EXCL      /**/  &kp QUESTION  &kp F                &kp O    &kp U        &kp J       &mo OPTIONS
                &kp FSLH     &kp N     &kp R     &kp T              &kp S                 &kp G         /**/  &kp Y         &kp H                &kp A    &kp E        &kp I       &none
                &none        &kp Q     &kp X     &kp M              &kp C                 &kp V         /**/  &kp K         &kp P                &kp DOT  &kp COMMA    &kp SEMI    &kp RIGHT_SHIFT
                             &mkp MB2  &mkp MB1  &num_hold_cleanup  &edit_lt EDIT SPACE   &mo VSCROLL   /**/  &none         &edit_lt EDIT SPACE                        &none
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
                &trans        &none         &kp NUMBER_9  &kp NUMBER_8  &kp NUMBER_7  &none   /**/  &none   &kp ASTRK      &kp FSLH        &kp PRCNT      &none         &trans
                &none         &none         &kp NUMBER_6  &kp NUMBER_5  &kp NUMBER_4  &none   /**/  &none   &kp PLUS       &kp MINUS       &none          &none         &none
                &tog_on FUN   &kp NUMBER_0  &kp NUMBER_3  &kp NUMBER_2  &kp NUMBER_1  &none   /**/  &none   &kp EQUAL      &kp DOT         &none          &none         &tog_on FUN
                              &trans        &trans        &trans        &trans        &trans  /**/  &trans  &trans                                        &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
                &trans    &kp F12  &kp F9   &kp F8  &kp F7  &none    /**/  &none     &kp F7  &kp F8  &kp F9  &kp F12  &trans
                &trans    &kp F11  &kp F6   &kp F5  &kp F4  &none    /**/  &none     &kp F4  &kp F5  &kp F6  &kp F11  &trans
                &none     &kp F10  &kp F3   &kp F2  &kp F1  &none    /**/  &none     &kp F1  &kp F2  &kp F3  &kp F10  &none
                          &trans   &trans   &trans  &trans  &trans   /**/  &trans    &trans                  &trans
            >;
        };

        edit_layer {
            label = "EDIT";
            bindings = <
                &none    &kp DELETE  &kp TAB          &kp ENTER  &kp BACKSPACE  &none    /**/  &none     &kp BACKSPACE  &kp ENTER  &kp TAB    &kp DELETE     &none
                &none    &sk LCTRL   &kp LGUI         &kp LALT   &kp LSHIFT     &none    /**/  &none     &kp LSHIFT     &kp LALT   &kp LGUI   &kp LCTRL      &none
                &none    &mkp MB3    &tog_on VSCROLL  &mkp MB2   &mkp MB1       &none    /**/  &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &tog_on SNIPE  &none
                         &mkp MB4    &mkp MB5         &none      &none          &none    /**/  &none     &none                                &none
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
                &none    &kp DELETE  &kp TAB          &kp ENTER  &kp BACKSPACE  &none    /**/  &none     &kp BACKSPACE  &kp ENTER  &kp TAB    &kp DELETE      &none
                &none    &sk LCTRL   &kp LGUI         &kp LALT   &kp LSHIFT     &none    /**/  &none     &kp LSHIFT     &kp LALT   &kp LGUI   &kp LCTRL       &none
                &none    &mkp MB3    &tog_on VSCROLL  &mkp MB2   &mkp MB1       &none    /**/  &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &tog_off SNIPE  &none
                         &mkp MB4    &mkp MB5         &none      &none          &none    /**/  &none     &none                                &none
            >;
        };

        scroll_layer {
            label = "VSCROLL";
            bindings = <
                &none    &none  &none                &none  &none  &none  /**/  &none  &none  &none  &none  &none  &none
                &none    &none  &none                &none  &none  &none  /**/  &none  &none  &none  &none  &none  &none
                &none    &none  &scroll_horizontal   &none  &none  &none  /**/  &none  &none  &none  &none  &none  &none
                         &none  &none                &none  &none  &none  /**/  &none  &none                &none
            >;
        };

        horizontal_scroll_layer {
            label = "HSCROLL";
            bindings = <
                &none    &none  &none              &none  &none  &none  /**/  &none  &none  &none  &none  &none  &none
                &none    &none  &none              &none  &none  &none  /**/  &none  &none  &none  &none  &none  &none
                &none    &none  &scroll_vertical   &none  &none  &none  /**/  &none  &none  &none  &none  &none  &none
                         &none  &none              &none  &none  &none  /**/  &none  &none                &none
            >;
        };

        setting_layer {
            label = "SETTING";
            bindings = <
                &trans    &trans      &trans        &trans        &trans        &trans    /**/  &trans    &trans  &trans  &trans  &trans  &trans
                &trans    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans    /**/  &trans    &trans  &trans  &trans  &trans  &trans
                &trans    &trans      &trans        &trans        &trans        &trans    /**/  &trans    &trans  &trans  &trans  &trans  &trans
                          &trans      &trans        &trans        &trans        &trans    /**/  &trans    &trans                  &trans
            >;
        };

        switch_layer {
            label = "SWITCH";
            bindings = <
                &none    &none  &none       &none        &none    &none    /**/  &none    &none    &none        &none       &none  &none
                &none    &none  &kp ESCAPE  &kp LS(TAB)  &kp TAB  &none    /**/  &none    &kp TAB  &kp LS(TAB)  &kp ESCAPE  &none  &none
                &none    &none  &kp ESCAPE  &kp LS(TAB)  &kp TAB  &none    /**/  &none    &kp TAB  &kp LS(TAB)  &kp ESCAPE  &none  &none
                         &none  &none       &none        &none    &none    /**/  &none    &none                             &none
            >;
        };

        options_layer {
            label = "OPTIONS";
            bindings = <
                &none              &none      &none        &none        &none        &bootloader  /**/  &bootloader  &none  &none  &none  &none  &none
                &sys_reset         &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none        /**/  &none        &none  &none  &none  &none  &sys_reset
                &ext_power EP_OFF  &none      &none        &none        &none        &none        /**/  &none        &none  &none  &none  &none  &ext_power EP_ON
                                   &none      &none        &none        &none        &none        /**/  &none        &none                &none
            >;
        };
    };
};
